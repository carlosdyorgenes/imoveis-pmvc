generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  MASTER
  PADRAO
}

enum TipoImovel {
  PROPRIO
  LOCADO
}

enum ZonaImovel {
  URBANO
  RURAL
}

enum CategoriaImovel {
  AREA_VERDE
  AREA_INSTITUCIONAL
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(PADRAO)
  // Perfil customizado opcional: concede permissões extras a um usuário PADRAO sem
  // torná-lo MASTER. MASTER sempre tem acesso total, com ou sem perfil.
  perfilId  String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  perfil                 Perfil?                  @relation(fields: [perfilId], references: [id])
  ocorrencias            Ocorrencia[]
  tarefaCards            TarefaCard[]
  logs                   Log[]
  tarefasCreated         Tarefa[]
  solicitacoesSenha      SolicitacaoSenha[]       @relation("SolicitacaoUser")
  solicitacoesResolvidas SolicitacaoSenha[]       @relation("SolicitacaoResolved")
  demandasCriadas        Demanda[]                @relation("DemandaSolicitante")
  atividadesResponsavel  Atividade[]              @relation("AtividadeResponsavel")
  atividadesCriadas      Atividade[]              @relation("AtividadeSolicitante")
  equipeMembros          EquipeMembro[]
  notificacoes           Notificacao[]
  comentarios            Comentario[]
  transferenciasOrigem   HistoricoTransferencia[] @relation("TransferenciaDe")
  transferenciasDestino  HistoricoTransferencia[] @relation("TransferenciaPara")
  resumosConsultados     ResumoConsulta[]
  visualizacoesMaster    DemandaVisualizacaoMaster[]

  @@map("users")
}

// Perfil customizável (RBAC dinâmico simplificado): o admin define um conjunto de
// permissões nomeadas e atribui o perfil a usuários PADRAO. Não substitui MASTER/PADRAO
// (que continuam controlando o restante do sistema já validado) — apenas adiciona acesso
// a recursos administrativos específicos deste módulo (equipes, tipos de demanda etc.).
model Perfil {
  id         String   @id @default(uuid())
  nome       String   @unique
  descricao  String?
  permissoes String[] @default([])
  createdAt  DateTime @default(now())

  usuarios User[]

  @@map("perfis")
}

model Comentario {
  id          String   @id @default(uuid())
  demandaId   String
  atividadeId String?
  userId      String
  texto       String
  createdAt   DateTime @default(now())

  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@map("comentarios")
}

model Equipe {
  id        String   @id @default(uuid())
  nome      String   @unique
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  membros    EquipeMembro[]
  atividades Atividade[]

  @@map("equipes")
}

model EquipeMembro {
  id        String  @id @default(uuid())
  equipeId  String
  userId    String
  principal Boolean @default(false)

  equipe Equipe @relation(fields: [equipeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([equipeId, userId])
  @@map("equipe_membros")
}

enum StatusDemanda {
  ABERTA
  EM_ANDAMENTO
  PARCIALMENTE_CONCLUIDA
  AGUARDANDO_TERCEIRO
  DEVOLVIDA
  CONCLUIDA
  CANCELADA
}

enum PrioridadeDemanda {
  ALTA
  MEDIA
  BAIXA
}

enum StatusAtividade {
  ATRIBUIDA
  EM_ANDAMENTO
  CONCLUIDA
  DEVOLVIDA
  APROVADA
  CANCELADA
  AGUARDANDO_INFORMACAO
  REABERTA
}

model Demanda {
  id            String            @id @default(uuid())
  gepNumero     String
  gepAno        String
  assunto       String
  descricao     String?
  interessado   String?
  status        StatusDemanda     @default(ABERTA)
  prioridade    PrioridadeDemanda @default(MEDIA)
  prazo         DateTime?
  escalonado    Boolean           @default(false)
  solicitanteId String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  solicitante        User               @relation("DemandaSolicitante", fields: [solicitanteId], references: [id])
  atividades         Atividade[]
  historico          HistoricoDemanda[]
  pendenciasExternas PendenciaExterna[]
  comentarios        Comentario[]
  resumosConsultados ResumoConsulta[]
  visualizacoesMaster DemandaVisualizacaoMaster[]
  relatorioGeralCache RelatorioGeralCache?

  @@index([gepNumero, gepAno])
  @@map("demandas")
}

// Guarda, por usuário e por demanda, uma "assinatura" do estado das atividades na última vez
// que o Master abriu o Resumo da demanda — permite avisar se algo mudou desde então mesmo
// trocando de computador/navegador (antes isso ficava só no localStorage do dispositivo).
model ResumoConsulta {
  id          String   @id @default(uuid())
  demandaId   String
  userId      String
  assinatura  String
  // Guarda o último texto em prosa gerado por IA (e por qual provedor) pra essa demanda+usuário,
  // pra poder ser reconsultado sem gastar de novo com a IA quando nada mudou desde então.
  textoProsaIA     String?
  provedorProsaIA  String?
  atualizadoEm DateTime @updatedAt

  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demandaId, userId])
  @@map("resumo_consultas")
}

// Cache global (não por usuário — é um relatório oficial, não um rascunho pessoal) do texto de
// IA gerado para o Relatório Geral. Uma "assinatura" (hash do texto de entrada montado a partir
// das atividades/checklist/observações/pendências) decide se a demanda mudou desde a última vez
// que o relatório foi gerado — se não mudou, reaproveita o texto salvo em vez de gastar de novo
// com a IA.
model RelatorioGeralCache {
  id           String   @id @default(uuid())
  demandaId    String   @unique
  assinatura   String
  historico    String
  provedor     String
  atualizadoEm DateTime @updatedAt

  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  @@map("relatorio_geral_cache")
}

// Marca, por Master, quando ele visualizou por último uma demanda — usada só pra saber se
// houve atualização (qualquer atividade) desde essa última visita, e mostrar/sumir a tag de
// aviso na listagem de Demandas. Cada Master tem seu próprio "visto por último".
model DemandaVisualizacaoMaster {
  id        String   @id @default(uuid())
  demandaId String
  userId    String
  vistoEm   DateTime @default(now())

  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([demandaId, userId])
  @@map("demanda_visualizacoes_master")
}

// Atividade é atribuída a um usuário OU a uma equipe (qualquer membro da equipe pode agir).
model Atividade {
  id                     String          @id @default(uuid())
  demandaId              String
  titulo                 String
  instrucoes             String?
  responsavelId          String?
  equipeId               String?
  solicitanteId          String
  status                 StatusAtividade @default(ATRIBUIDA)
  // Prioridade da atividade em si — pode divergir da prioridade geral da demanda (ex.: demanda
  // Média com uma atividade específica Alta). Rege a ordenação da fila do responsável.
  prioridade             PrioridadeDemanda @default(MEDIA)
  prazo                  DateTime?
  observacoes            String?
  motivoDevolucao        String?
  linkDocumento          String?
  // Sim/não a atividade exige PDF anexado para poder ser finalizada.
  anexoObrigatorio       Boolean         @default(false)
  // Marcados na transição de status (não recalculados) — base para os indicadores de tempo.
  dataInicio             DateTime?
  dataConclusao          DateTime?
  // Texto obrigatório preenchido no modal de finalização ("informações das solicitações atendidas no GEP").
  informacoesFinalizacao String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  demanda        Demanda                  @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  responsavel    User?                    @relation("AtividadeResponsavel", fields: [responsavelId], references: [id])
  equipe         Equipe?                  @relation(fields: [equipeId], references: [id])
  solicitante    User                     @relation("AtividadeSolicitante", fields: [solicitanteId], references: [id])
  passos             PassoAtividade[]
  documentos         DocumentoAtividade[]
  transferencias     HistoricoTransferencia[]
  pendenciasExternas PendenciaExterna[]

  @@map("atividades")
}

// Registro imutável de cada transferência de atividade entre usuários da mesma equipe.
model HistoricoTransferencia {
  id            String   @id @default(uuid())
  atividadeId   String
  deUsuarioId   String
  paraUsuarioId String
  justificativa String
  createdAt     DateTime @default(now())

  atividade   Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  deUsuario   User      @relation("TransferenciaDe", fields: [deUsuarioId], references: [id])
  paraUsuario User      @relation("TransferenciaPara", fields: [paraUsuarioId], references: [id])

  @@map("historico_transferencias")
}

model DocumentoAtividade {
  id             String   @id @default(uuid())
  atividadeId    String
  nome           String
  linkDrive      String
  versao         Int      @default(1)
  createdById    String?
  // Preenchido quando o documento é um arquivo enviado (upload real), não um link do Drive.
  arquivoPath    String?
  arquivoMime    String?
  arquivoTamanho Int?
  // Hash SHA-256 do conteúdo do arquivo, calculado no upload — permite verificar
  // integridade (o arquivo não foi corrompido/alterado) a qualquer momento.
  arquivoHash    String?
  createdAt      DateTime @default(now())

  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  @@map("documentos_atividade")
}

model PendenciaExterna {
  id              String    @id @default(uuid())
  demandaId       String
  // Pendência sempre nasce vinculada a uma atividade específica (nunca mais "solta" na
  // demanda) — nullable só para não quebrar registros antigos criados antes dessa mudança.
  atividadeId     String?
  orgao           String
  descricao       String
  dataSolicitacao DateTime  @default(now())
  protocolo       String?
  prazoEsperado   DateTime?
  status          String    @default("AGUARDANDO")
  resposta        String?
  ultimaCobranca  DateTime?
  // Evita notificar de novo a cada vez que a rota "preguiçosa" roda (ver escalonarPrazosVencidos
  // em demandas.routes.ts) — volta pra false automaticamente se o prazoEsperado for alterado.
  notificacaoVencimentoEnviada Boolean @default(false)
  createdAt       DateTime  @default(now())

  demanda   Demanda    @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  atividade Atividade? @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  @@map("pendencias_externas")
}

model Notificacao {
  id          String   @id @default(uuid())
  userId      String
  tipo        String
  mensagem    String
  demandaId   String?
  atividadeId String?
  lida        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notificacoes")
}

model PassoAtividade {
  id          String   @id @default(uuid())
  atividadeId String
  descricao   String
  concluido   Boolean  @default(false)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())

  atividade Atividade @relation(fields: [atividadeId], references: [id], onDelete: Cascade)

  @@map("passos_atividade")
}

model HistoricoDemanda {
  id          String   @id @default(uuid())
  demandaId   String
  // Preenchido quando o evento é específico de uma atividade (ex: criada, status, transferida,
  // documento anexado) — usado para ocultar esses eventos de usuários que não podem ver aquela
  // atividade (isolamento entre áreas). Nulo para eventos do nível da demanda (todos veem).
  atividadeId String?
  userId      String?
  acao        String
  descricao   String
  createdAt   DateTime @default(now())

  demanda Demanda @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  @@map("historico_demandas")
}

model Imovel {
  id                   String     @id @default(uuid())
  inscricaoImobiliaria String     @unique
  registroCartorario   String?
  cartorioImoveis      String?
  logradouro           String
  numero               String?
  complemento          String?
  bairro               String
  cidade               String
  estado               String
  cep                  String?
  secretaria           String
  tipo                 TipoImovel
  zona                 ZonaImovel
  // Nem todo imóvel se encaixa nessa classificação (só quando for Área Verde ou
  // Institucional) — por isso opcional, sem quebrar cadastros já existentes.
  categoria            CategoriaImovel?
  latitude             Float?
  longitude            Float?
  area                 Float?
  observacoes          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  documentos  Documento[]
  ocorrencias Ocorrencia[]
  tarefaCards TarefaCard[]

  @@map("imoveis")
}

model Documento {
  id        String   @id @default(uuid())
  imovelId  String
  descricao String
  linkDrive String
  createdAt DateTime @default(now())

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)

  @@map("documentos")
}

model Ocorrencia {
  id        String   @id @default(uuid())
  imovelId  String
  userId    String
  descricao String
  tipo      String   @default("MANUAL")
  createdAt DateTime @default(now())

  imovel Imovel @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@map("ocorrencias")
}

model Tarefa {
  id          String   @id @default(uuid())
  titulo      String
  descricao   String?
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  createdBy User    @relation(fields: [createdById], references: [id])
  etapas    Etapa[]

  @@map("tarefas")
}

model Etapa {
  id        String   @id @default(uuid())
  tarefaId  String
  titulo    String
  ordem     Int      @default(0)
  createdAt DateTime @default(now())

  tarefa Tarefa       @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  cards  TarefaCard[]

  @@map("etapas")
}

model TarefaCard {
  id          String   @id @default(uuid())
  etapaId     String
  imovelId    String
  userId      String
  observacoes String?
  ordem       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  etapa  Etapa   @relation(fields: [etapaId], references: [id], onDelete: Cascade)
  imovel Imovel  @relation(fields: [imovelId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])
  passos Passo[]

  @@map("tarefa_cards")
}

model Passo {
  id          String   @id @default(uuid())
  cardId      String
  descricao   String
  concluido   Boolean  @default(false)
  ordem       Int      @default(0)
  // Etapa em que o passo foi criado (snapshot para histórico)
  etapaId     String?
  etapaTitulo String?
  createdAt   DateTime @default(now())

  card TarefaCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@map("passos")
}

model SolicitacaoSenha {
  id           String    @id @default(uuid())
  userId       String
  status       String    @default("PENDENTE")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?

  user       User  @relation("SolicitacaoUser", fields: [userId], references: [id])
  resolvedBy User? @relation("SolicitacaoResolved", fields: [resolvedById], references: [id])

  @@map("solicitacoes_senha")
}

model Log {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("logs")
}
